 			 void *data);
 bool tegra_bpmp_mrq_is_supported(struct tegra_bpmp *bpmp, unsigned int mrq);
+int tegra_bpmp_sysfs_register(struct tegra_bpmp *bpmp);
 #else
 static inline struct tegra_bpmp *tegra_bpmp_get(struct device *dev)
 {
