From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: John Cabaj <john.cabaj@canonical.com>
Date: Thu, 27 Mar 2025 14:58:11 -0500
Subject: [PATCH] Revert "UBUNTU: SAUCE: clocksource: hyper-v: Use InvariantTSC
 and enable TSC page for a TDX VM without paravisor"

BugLink: https://bugs.launchpad.net/bugs/2104836

This reverts commit b0a379c6568a18e72607b7c0f85799f6d0c6070f.

Upstream 7f828d5fff7d: "clocksource: hyper-v: Use lapic timer
in a TDX VM without paravisor" has since been committed to Ubuntu
kernels 6.8 and newer, which removes the need for this SAUCE patch.

Signed-off-by: John Cabaj <john.cabaj@canonical.com>
Acked-by: Kuba Pawlak <kuba.pawlak@canonical.com>
Acked-by: Massimiliano Pellizzer <massimiliano.pellizzer@canonical.com>
Signed-off-by: John Cabaj <john.cabaj@canonical.com>
Ledger-Change: C-00833
Ledger-Origin: azure@2858b0b771b5db746065d6468b0601b826e661b6
---
 arch/x86/entry/vdso/vma.c          | 11 +++--------
 arch/x86/kernel/cpu/mshyperv.c     |  8 ++++++++
 drivers/clocksource/hyperv_timer.c | 16 ++--------------
 3 files changed, 13 insertions(+), 22 deletions(-)

diff --git a/arch/x86/entry/vdso/vma.c b/arch/x86/entry/vdso/vma.c
index 98b5d8cef81e..c7f6ab5879f3 100644
--- a/arch/x86/entry/vdso/vma.c
+++ b/arch/x86/entry/vdso/vma.c
@@ -18,7 +18,6 @@
 #include <linux/vdso_datastore.h>
 
 #include <asm/pvclock.h>
-#include <asm/mshyperv.h>
 #include <asm/vgtod.h>
 #include <asm/proto.h>
 #include <asm/vdso.h>
@@ -130,13 +129,9 @@ static vm_fault_t vvar_vclock_fault(const struct vm_special_mapping *sm,
 	case VDSO_PAGE_HVCLOCK_OFFSET:
 	{
 		unsigned long pfn = hv_get_tsc_pfn();
-		if (pfn && vclock_was_used(VDSO_CLOCKMODE_HVCLOCK)) {
-			if (ms_hyperv.paravisor_present)
-				return vmf_insert_pfn(vma, vmf->address, pfn);
-			else
-				return vmf_insert_pfn_prot(vma, vmf->address,
-					pfn, pgprot_decrypted(vma->vm_page_prot));
-		}
+
+		if (pfn && vclock_was_used(VDSO_CLOCKMODE_HVCLOCK))
+			return vmf_insert_pfn(vma, vmf->address, pfn);
 		break;
 	}
 	}
diff --git a/arch/x86/kernel/cpu/mshyperv.c b/arch/x86/kernel/cpu/mshyperv.c
index a8bd12767c02..b4af7c0a70ac 100644
--- a/arch/x86/kernel/cpu/mshyperv.c
+++ b/arch/x86/kernel/cpu/mshyperv.c
@@ -617,6 +617,14 @@ static void __init ms_hyperv_init_platform(void)
 
 			if (!ms_hyperv.paravisor_present) {
 				hypercall_update(hv_tdx_hypercall);
+				/*
+				 * Mark the Hyper-V TSC page feature as disabled
+				 * in a TDX VM without paravisor so that the
+				 * Invariant TSC, which is a better clocksource
+				 * anyway, is used instead.
+				 */
+				ms_hyperv.features &= ~HV_MSR_REFERENCE_TSC_AVAILABLE;
+
 				/*
 				 * The Invariant TSC is expected to be available
 				 * in a TDX VM without paravisor, but if not,
diff --git a/drivers/clocksource/hyperv_timer.c b/drivers/clocksource/hyperv_timer.c
index e85bc0c3585d..dddfff458ebf 100644
--- a/drivers/clocksource/hyperv_timer.c
+++ b/drivers/clocksource/hyperv_timer.c
@@ -23,7 +23,6 @@
 #include <linux/acpi.h>
 #include <linux/hyperv.h>
 #include <linux/export.h>
-#include <linux/set_memory.h>
 #include <clocksource/hyperv_timer.h>
 #include <hyperv/hvhdk.h>
 #include <asm/mshyperv.h>
@@ -296,8 +295,8 @@ static __always_inline u64 read_hv_clock_msr(void)
 
 static union {
 	struct ms_hyperv_tsc_page page;
-	u8 reserved[SZ_2M];
-} tsc_pg __bss_decrypted __aligned(SZ_2M);
+	u8 reserved[PAGE_SIZE];
+} tsc_pg __bss_decrypted __aligned(PAGE_SIZE);
 
 static struct ms_hyperv_tsc_page *tsc_page = &tsc_pg.page;
 static unsigned long tsc_pfn;
@@ -457,7 +456,6 @@ static __always_inline void hv_setup_sched_clock(void *sched_clock) {}
 static void __init hv_init_tsc_clocksource(void)
 {
 	union hv_reference_tsc_msr tsc_msr;
-	int ret;
 
 	/*
 	 * When running as a guest partition:
@@ -485,12 +483,6 @@ static void __init hv_init_tsc_clocksource(void)
 
 	hv_read_reference_counter = read_hv_clock_tsc;
 
-	if (hv_isolation_type_tdx() && !ms_hyperv.paravisor_present) {
-		ret = set_memory_decrypted((unsigned long)tsc_page, SZ_2M/PAGE_SIZE);
-		BUG_ON(ret);
-		memset(tsc_page, 0, PAGE_SIZE);
-	}
-
 	/*
 	 * TSC page mapping works differently in root compared to guest.
 	 * - In guest partition the guest PFN has to be passed to the
@@ -514,10 +506,6 @@ static void __init hv_init_tsc_clocksource(void)
 		tsc_pfn = HVPFN_DOWN(virt_to_phys(tsc_page));
 	tsc_msr.enable = 1;
 	tsc_msr.pfn = tsc_pfn;
-
-	if (hv_isolation_type_tdx() && !ms_hyperv.paravisor_present)
-		tsc_msr.pfn = PHYS_PFN(cc_mkdec(PFN_PHYS(tsc_msr.pfn)));
-
 	hv_set_msr(HV_MSR_REFERENCE_TSC, tsc_msr.as_uint64);
 
 	clocksource_register_hz(&hyperv_cs_tsc, NSEC_PER_SEC/100);
