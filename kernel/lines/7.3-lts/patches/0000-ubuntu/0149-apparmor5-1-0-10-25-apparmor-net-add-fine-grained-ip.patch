-	return aa_profile_af_sk_perm(profile, ad, request, sk);
+	struct aa_ruleset *rules = profile->label.rules[0];
+	struct aa_perms *p = NULL;
+	aa_state_t state;
+
+	state = RULE_MEDIATES_SK(rules, sk);
