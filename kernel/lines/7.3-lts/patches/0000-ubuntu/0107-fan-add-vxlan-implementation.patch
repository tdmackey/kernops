 };
 
 /* Kernel-side variant of ip_tunnel_parm */
@@ -210,6 +219,11 @@ struct ip_tunnel {
 	bool			ignore_df;
 };
 
+static inline int fan_has_map(const struct ip_tunnel_fan *fan)
+{
+	return !list_empty(&fan->fan_maps);
+}
