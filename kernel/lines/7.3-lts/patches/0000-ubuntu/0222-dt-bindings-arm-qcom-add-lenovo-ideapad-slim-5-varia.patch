+++ b/Documentation/devicetree/bindings/arm/qcom.yaml
@@ -1255,6 +1255,13 @@ properties:
           - const: asus,zenbook-a14-ux3407qa
           - const: qcom,x1p42100
 
+      - items:
+          - enum:
+              - lenovo,ideapad-slim5x-lcd
+              - lenovo,ideapad-slim5x-oled
+          - const: lenovo,ideapad-5
+          - const: qcom,x1p42100
+
       - items:
           - enum:
               - acer,swift-sf14-11
