From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Tobias Heider <tobias.heider@canonical.com>
Date: Mon, 23 Mar 2026 10:40:48 +0100
Subject: [PATCH] UBUNTU: SAUCE: arm64: dts: qcom: x1e80100-lenovo-yoga-slim7x:
 Fix RGB camera supplies

Use voltage from Aleks Vinarskis as we did in 6.19.
See https://lore.kernel.org/linux-arm-msm/CAARv3RSQbAQwDFsfBrcrkXem_jtVy0Xttqi1UZfuNT86twxmJw@mail.gmail.com/

Signed-off-by: Tobias Heider <tobias.heider@canonical.com>
Signed-off-by: Paolo Pisati <paolo.pisati@canonical.com>
Ledger-Change: C-00299
Ledger-Origin: ubuntu@ba2e234c9400f705848ab96cfc36d6f87b9bdfdd
---
 arch/arm64/boot/dts/qcom/x1e80100-lenovo-yoga-slim7x.dts | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/arch/arm64/boot/dts/qcom/x1e80100-lenovo-yoga-slim7x.dts b/arch/arm64/boot/dts/qcom/x1e80100-lenovo-yoga-slim7x.dts
index 50ac55a62f6f..a8e41d9354a8 100644
--- a/arch/arm64/boot/dts/qcom/x1e80100-lenovo-yoga-slim7x.dts
+++ b/arch/arm64/boot/dts/qcom/x1e80100-lenovo-yoga-slim7x.dts
@@ -571,8 +571,8 @@ vreg_l2b_3p0: ldo2 {
 
 		vreg_l7b_2p8: ldo7 {
 			regulator-name = "vreg_l7b_2p8";
-			regulator-min-microvolt = <3072000>;
-			regulator-max-microvolt = <3072000>;
+			regulator-min-microvolt = <2800000>;
+			regulator-max-microvolt = <2800000>;
 			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
 		};
 
