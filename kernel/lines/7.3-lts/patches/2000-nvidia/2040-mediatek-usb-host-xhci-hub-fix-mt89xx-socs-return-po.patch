Signed-off-by: Jacob Martin <jacob.martin@canonical.com>
(backported from commit d4af5f3f59f3b75772336f4d094ac1c3f6f7f880 resolute:linux-nvidia-bos)
[jacobmartin: adjusted for upstream's rename of temp to portsc in xhci_hub_control()]
Signed-off-by: Jacob Martin <jacob.martin@canonical.com>
Ledger-Change: C-00484
Ledger-Origin: nvidia@eb4210fff9783d3b1adac4ed604ae33e82553587
---
 drivers/usb/host/xhci-hub.c | 11 +++++++++++
 1 file changed, 11 insertions(+)

diff --git a/drivers/usb/host/xhci-hub.c b/drivers/usb/host/xhci-hub.c
index 470bafe1802b..87260ac90a3e 100644
--- a/drivers/usb/host/xhci-hub.c
+++ b/drivers/usb/host/xhci-hub.c
@@ -1266,6 +1266,17 @@ int xhci_hub_control(struct usb_hcd *hcd, u16 typeReq, u16 wValue,
 			}
 			port_li = readl(&port->port_reg->portli);
 			status = xhci_get_ext_port_status(portsc, port_li);
+
+			/*
+			 * In MT8901 USB host controller, the lane count can be wrongly set
+			 * to 2 instead of 1 for USB Gen2x1 devices due to a HW Bug. As a SW
+			 * WAR, check if port speed is 0x5 (SuperSpeedPlus Gen2x1) in
+			 * PORTSC register and update the lane count as 1.
+			 */
+			if ((xhci->quirks & XHCI_NVIDIA_MT8901_HOST) &&
+			    DEV_SUPERSPEEDPLUS(portsc))
+				status &= ~0xff00;
+
 			put_unaligned_le32(status, &buf[4]);
 		}
 		break;
