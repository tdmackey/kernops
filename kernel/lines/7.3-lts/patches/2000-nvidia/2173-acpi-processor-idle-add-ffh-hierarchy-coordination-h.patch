 drivers/acpi/arm64/cpuidle.c  | 42 +++++++++++++++++++++++++++++++++++
 drivers/acpi/processor_idle.c | 21 ++++++++++++++++++
 drivers/firmware/psci/psci.c  |  2 +-
 include/acpi/processor.h      |  4 ++++
 include/linux/psci.h          |  1 +
 5 files changed, 69 insertions(+), 1 deletion(-)

diff --git a/drivers/acpi/arm64/cpuidle.c b/drivers/acpi/arm64/cpuidle.c
index c68a5db8ebba..7dee326fd3f3 100644
--- a/drivers/acpi/arm64/cpuidle.c
+++ b/drivers/acpi/arm64/cpuidle.c
@@ -9,10 +9,18 @@
 #include <linux/acpi.h>
 #include <linux/cpuidle.h>
 #include <linux/cpu_pm.h>
+#include <linux/overflow.h>
 #include <linux/psci.h>
 #include <acpi/processor.h>
 
 #define ARM64_LPI_IS_RETENTION_STATE(arch_flags) (!(arch_flags))
+#define ARM64_LPI_WFI_ADDRESS			0xffffffffULL
+
+bool acpi_processor_ffh_lpi_is_wfi(const struct acpi_lpi_state *lpi)
+{
+	return lpi->entry_method == ACPI_CSTATE_FFH &&
+	       lpi->address == ARM64_LPI_WFI_ADDRESS;
+}
 
 static int psci_acpi_cpu_init_idle(unsigned int cpu)
 {
@@ -43,6 +51,12 @@ static int psci_acpi_cpu_init_idle(unsigned int cpu)
 			pr_warn("Invalid PSCI power state %#x\n", state);
 			return -EINVAL;
 		}
+		if (psci_power_state_loses_context(state) !=
+		    !!(lpi->arch_flags & CPUIDLE_CORE_CTXT)) {
+			pr_warn("PSCI context-loss mismatch for state %#x\n",
+				state);
+			return -EINVAL;
+		}
 	}
 
 	return 0;
@@ -53,6 +67,34 @@ int acpi_processor_ffh_lpi_probe(unsigned int cpu)
 	return psci_acpi_cpu_init_idle(cpu);
 }
 
+bool acpi_processor_ffh_lpi_hierarchy_supported(void)
+{
+	return psci_has_osi_support();
+}
+
+int acpi_processor_ffh_lpi_set_mode(bool enable)
+{
+	return psci_set_osi_mode(enable);
+}
+
+int acpi_processor_ffh_lpi_prepare_state(struct acpi_lpi_state *lpi)
+{
+	if (lpi->entry_method != ACPI_CSTATE_FFH)
+		return -EINVAL;
+
+	if (check_add_overflow(lpi->address, lpi->level_id, &lpi->address))
+		return -EOVERFLOW;
+	if (upper_32_bits(lpi->address))
+		return -ERANGE;
+	if (!psci_power_state_is_valid(lower_32_bits(lpi->address)))
+		return -EINVAL;
+	if (psci_power_state_loses_context(lower_32_bits(lpi->address)) !=
+	    !!(lpi->arch_flags & CPUIDLE_CORE_CTXT))
+		return -EINVAL;
+
+	return 0;
+}
+
 __cpuidle int acpi_processor_ffh_lpi_enter(struct acpi_lpi_state *lpi)
 {
 	u32 state = lpi->address;
diff --git a/drivers/acpi/processor_idle.c b/drivers/acpi/processor_idle.c
index 9cc5f02b0b31..8eb26ba2f405 100644
--- a/drivers/acpi/processor_idle.c
+++ b/drivers/acpi/processor_idle.c
@@ -859,6 +859,27 @@ int __weak acpi_processor_ffh_lpi_probe(unsigned int cpu)
 	return -EOPNOTSUPP;
 }
 
+bool __weak
+acpi_processor_ffh_lpi_is_wfi(const struct acpi_lpi_state *lpi)
+{
+	return false;
+}
+
+bool __weak acpi_processor_ffh_lpi_hierarchy_supported(void)
+{
+	return false;
+}
+
+int __weak acpi_processor_ffh_lpi_set_mode(bool enable)
+{
+	return -EOPNOTSUPP;
+}
+
+int __weak acpi_processor_ffh_lpi_prepare_state(struct acpi_lpi_state *lpi)
+{
+	return -EOPNOTSUPP;
+}
+
 static int acpi_processor_get_lpi_info(struct acpi_processor *pr)
 {
 	int ret;
diff --git a/drivers/firmware/psci/psci.c b/drivers/firmware/psci/psci.c
index e73bae6cb23a..8dd6e328d1c2 100644
--- a/drivers/firmware/psci/psci.c
+++ b/drivers/firmware/psci/psci.c
@@ -91,7 +91,7 @@ bool psci_has_osi_support(void)
 	return psci_cpu_suspend_feature & PSCI_1_0_OS_INITIATED;
 }
 
-static inline bool psci_power_state_loses_context(u32 state)
+bool psci_power_state_loses_context(u32 state)
 {
 	const u32 mask = psci_has_ext_power_state() ?
 					PSCI_1_0_EXT_POWER_STATE_TYPE_MASK :
diff --git a/include/acpi/processor.h b/include/acpi/processor.h
index ca517afd86e1..aef1e53c0375 100644
--- a/include/acpi/processor.h
+++ b/include/acpi/processor.h
@@ -473,7 +473,11 @@ int acpi_processor_hotplug(struct acpi_processor *pr);
 void acpi_processor_register_idle_driver(void);
 void acpi_processor_unregister_idle_driver(void);
 int acpi_processor_ffh_lpi_probe(unsigned int cpu);
+bool acpi_processor_ffh_lpi_is_wfi(const struct acpi_lpi_state *lpi);
 int acpi_processor_ffh_lpi_enter(struct acpi_lpi_state *lpi);
+bool acpi_processor_ffh_lpi_hierarchy_supported(void);
+int acpi_processor_ffh_lpi_set_mode(bool enable);
+int acpi_processor_ffh_lpi_prepare_state(struct acpi_lpi_state *lpi);
 #endif /* CONFIG_ACPI_PROCESSOR_IDLE */
 
 /* in processor_thermal.c */
diff --git a/include/linux/psci.h b/include/linux/psci.h
index 4ca0060a3fc4..26779e016548 100644
--- a/include/linux/psci.h
+++ b/include/linux/psci.h
@@ -18,6 +18,7 @@ bool psci_tos_resident_on(int cpu);
 
 int psci_cpu_suspend_enter(u32 state);
 bool psci_power_state_is_valid(u32 state);
+bool psci_power_state_loses_context(u32 state);
 int psci_set_osi_mode(bool enable);
 bool psci_has_osi_support(void);
 
