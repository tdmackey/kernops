 	if (lpi_pkg->package.count < 10)
-		return;
+		return 0;
 
 	obj = &lpi_pkg_elem[9];
 	if (obj->type == ACPI_TYPE_STRING)
 		strscpy(lpi_state->desc, obj->string.pointer, ACPI_CX_DESC_LEN);
+	else if (hierarchy_strict)
