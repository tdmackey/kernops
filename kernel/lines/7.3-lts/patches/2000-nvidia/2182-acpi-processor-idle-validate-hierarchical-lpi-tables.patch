 	}
 
 	acpi_handle_debug(handle, "Found %u power states\n", lpi_pkg_count);
@@ -1173,14 +1242,26 @@ static int acpi_processor_evaluate_lpi(acpi_handle handle,
 	return ret;
 }
 
-#define ACPI_LPI_STATE_FLAGS_ENABLED			BIT(0)
-
 static void stash_composite_state(struct acpi_lpi_states_array *curr_level,
 				  struct acpi_lpi_state *t)
 {
 	curr_level->composite_states[curr_level->composite_states_size++] = t;
 }
 
+static bool
+acpi_lpi_eps_within_parent(const struct acpi_lpi_states_array *child,
+			   unsigned int parent_state_count)
+{
+	unsigned int i;
+
+	for (i = 0; i < child->size; i++)
+		if ((child->entries[i].flags & ACPI_LPI_STATE_FLAGS_ENABLED) &&
+		    child->entries[i].enable_parent_state > parent_state_count)
+			return false;
+
+	return true;
+}
+
 static bool too_many_states(acpi_handle handle, unsigned int state_count)
 {
 	if (state_count < ACPI_PROCESSOR_MAX_POWER)
@@ -1253,7 +1334,11 @@ static unsigned int flatten_lpi_states(acpi_handle handle,
  * folded into @pr_power. Level 0 is the processor leaf level, and each parent
  * container increments the level by one.
  *
- * If @cb returns an error, extraction aborts.
+ * When both @strict and @cb are set, validate the complete hierarchy-facing
+ * package contract, including the revision, reserved flags, counter-register
+ * objects, and Enabled Parent State bounds.  The stricter checks are limited
+ * to callback users so the legacy flattened parser keeps its compatibility
+ * behavior.  If @cb returns an error, extraction aborts.
  *
  * Return: 0 on success, or a negative error code on failure.
  */
@@ -1268,6 +1353,7 @@ int acpi_processor_extract_lpi_info_cb(acpi_handle pr_handle,
 	unsigned int state_count = 0;
 	unsigned int level = 0;
 	unsigned int i;
+	bool hierarchy_strict = strict && cb;
 	int ret;
 
 	if (!osc_pc_lpi_support_confirmed &&
@@ -1277,7 +1363,8 @@ int acpi_processor_extract_lpi_info_cb(acpi_handle pr_handle,
 	curr = &info[0];
 	curr->composite_states_size = 0;
 
-	ret = acpi_processor_evaluate_lpi(handle, curr, strict);
+	ret = acpi_processor_evaluate_lpi(handle, curr, strict,
+					  hierarchy_strict);
 	if (ret)
 		goto out_free;
 
@@ -1308,15 +1395,15 @@ int acpi_processor_extract_lpi_info_cb(acpi_handle pr_handle,
 		stash_composite_state(curr, flpi);
 	}
 
-	kfree(curr->entries);
-	curr->entries = NULL;
-
 	/*
 	 * If there are no _LPI states at the first level, there are no _LPI
 	 * states at all.
 	 */
-	if (!state_count)
+	if (!state_count) {
+		kfree(curr->entries);
+		curr->entries = NULL;
 		return -ENODATA;
+	}
 
 	prev = curr;
 	curr = &info[1];
@@ -1340,7 +1427,8 @@ int acpi_processor_extract_lpi_info_cb(acpi_handle pr_handle,
 		level++;
 		curr->composite_states_size = 0;
 
-		ret = acpi_processor_evaluate_lpi(handle, curr, strict);
+		ret = acpi_processor_evaluate_lpi(handle, curr, strict,
+						  hierarchy_strict);
 		if (ret) {
 			if (cb)
 				goto out_free;
@@ -1348,6 +1436,13 @@ int acpi_processor_extract_lpi_info_cb(acpi_handle pr_handle,
 			curr->entries = NULL;
 			break;
 		}
+		if (hierarchy_strict &&
+		    !acpi_lpi_eps_within_parent(prev, curr->size)) {
+			acpi_handle_debug(handle,
+					  "_LPI enabled parent state is out of range\n");
+			ret = -EINVAL;
+			goto out_free;
+		}
 
 		if (cb) {
 			ret = cb(handle, curr->entries, curr->size, level, data);
@@ -1359,11 +1454,19 @@ int acpi_processor_extract_lpi_info_cb(acpi_handle pr_handle,
 		state_count = flatten_lpi_states(pr_handle, pr_power->lpi_states,
 						 state_count, curr, prev);
 
-		kfree(curr->entries);
-		curr->entries = NULL;
+		kfree(prev->entries);
+		prev->entries = NULL;
 
 		tmp = prev, prev = curr, curr = tmp;
 	}
+	if (hierarchy_strict && !acpi_lpi_eps_within_parent(prev, 0)) {
+		acpi_handle_debug(handle,
+				  "Top-level _LPI state enables a parent\n");
+		ret = -EINVAL;
+		goto out_free;
+	}
+	kfree(prev->entries);
+	prev->entries = NULL;
 
 	/* reset the index after flattening */
 	for (i = 0; i < state_count; i++)
@@ -1374,7 +1477,8 @@ int acpi_processor_extract_lpi_info_cb(acpi_handle pr_handle,
 	return 0;
 
 out_free:
-	kfree(curr->entries);
+	kfree(info[0].entries);
+	kfree(info[1].entries);
 	return ret;
 }
 EXPORT_SYMBOL_NS_GPL(acpi_processor_extract_lpi_info_cb, "ACPI_PROCESSOR_IDLE");
diff --git a/drivers/acpi/arm64/cpuidle.c b/drivers/acpi/arm64/cpuidle.c
index 7dee326fd3f3..151853d2ab48 100644
--- a/drivers/acpi/arm64/cpuidle.c
+++ b/drivers/acpi/arm64/cpuidle.c
@@ -15,6 +15,10 @@
 
 #define ARM64_LPI_IS_RETENTION_STATE(arch_flags) (!(arch_flags))
 #define ARM64_LPI_WFI_ADDRESS			0xffffffffULL
+#define ARM64_LPI_FFH_BIT_WIDTH			32
+#define ARM64_LPI_FFH_BIT_OFFSET		0
+#define ARM64_LPI_FFH_ACCESS_SIZE		3
+#define ARM64_LPI_ARCH_FLAGS_MASK		GENMASK(3, 0)
 
 bool acpi_processor_ffh_lpi_is_wfi(const struct acpi_lpi_state *lpi)
 {
@@ -22,6 +26,33 @@ bool acpi_processor_ffh_lpi_is_wfi(const struct acpi_lpi_state *lpi)
 	       lpi->address == ARM64_LPI_WFI_ADDRESS;
 }
 
+static int arm64_lpi_validate_state(const struct acpi_lpi_state *lpi)
+{
+	u32 state;
+
+	if (lpi->entry_method != ACPI_CSTATE_FFH ||
+	    lpi->bit_width != ARM64_LPI_FFH_BIT_WIDTH ||
+	    lpi->bit_offset != ARM64_LPI_FFH_BIT_OFFSET ||
+	    lpi->access_size != ARM64_LPI_FFH_ACCESS_SIZE)
+		return -EINVAL;
+	if (lpi->arch_flags & ~ARM64_LPI_ARCH_FLAGS_MASK)
+		return -EINVAL;
+	if (upper_32_bits(lpi->address))
+		return -ERANGE;
+	if (acpi_processor_ffh_lpi_is_wfi(lpi) &&
+	    (lpi->arch_flags || lpi->enable_parent_state))
+		return -EINVAL;
+	if (acpi_processor_ffh_lpi_is_wfi(lpi))
+		return 0;
+
+	state = lower_32_bits(lpi->address);
+	if (psci_power_state_loses_context(state) !=
+	    !!(lpi->arch_flags & CPUIDLE_CORE_CTXT))
+		return -EINVAL;
+
+	return 0;
+}
+
 static int psci_acpi_cpu_init_idle(unsigned int cpu)
 {
 	int i;
@@ -38,10 +69,17 @@ static int psci_acpi_cpu_init_idle(unsigned int cpu)
 	if (!psci_ops.cpu_suspend)
 		return -EOPNOTSUPP;
 
-	for (i = 1; i < pr->power.count; i++) {
+	for (i = 0; i < pr->power.count; i++) {
 		u32 state;
 
 		lpi = &pr->power.lpi_states[i];
+		if (arm64_lpi_validate_state(lpi)) {
+			pr_warn("Invalid FFH LPI state at index %d\n", i);
+			return -EINVAL;
+		}
+		if (acpi_processor_ffh_lpi_is_wfi(lpi))
+			continue;
+
 		/*
 		 * Only bits[31:0] represent a PSCI power_state while
 		 * bits[63:32] must be 0x0 as per ARM ACPI FFH Specification
@@ -51,12 +89,6 @@ static int psci_acpi_cpu_init_idle(unsigned int cpu)
 			pr_warn("Invalid PSCI power state %#x\n", state);
 			return -EINVAL;
 		}
-		if (psci_power_state_loses_context(state) !=
-		    !!(lpi->arch_flags & CPUIDLE_CORE_CTXT)) {
-			pr_warn("PSCI context-loss mismatch for state %#x\n",
-				state);
-			return -EINVAL;
-		}
 	}
 
 	return 0;
@@ -79,8 +111,13 @@ int acpi_processor_ffh_lpi_set_mode(bool enable)
 
 int acpi_processor_ffh_lpi_prepare_state(struct acpi_lpi_state *lpi)
 {
-	if (lpi->entry_method != ACPI_CSTATE_FFH)
-		return -EINVAL;
+	int ret;
+
+	ret = arm64_lpi_validate_state(lpi);
+	if (ret)
+		return ret;
+	if (acpi_processor_ffh_lpi_is_wfi(lpi))
+		return 0;
 
 	if (check_add_overflow(lpi->address, lpi->level_id, &lpi->address))
 		return -EOVERFLOW;
