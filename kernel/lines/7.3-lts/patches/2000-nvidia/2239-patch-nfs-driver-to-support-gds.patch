 net/sunrpc/xprtrdma/frwr_ops.c      |  35 ++++++++-
 net/sunrpc/xprtrdma/nvfs.h          | 113 ++++++++++++++++++++++++++++
 net/sunrpc/xprtrdma/nvfs_rpc_rdma.c |  51 +++++++++++++
 net/sunrpc/xprtrdma/nvfs_rpc_rdma.h |  65 ++++++++++++++++
