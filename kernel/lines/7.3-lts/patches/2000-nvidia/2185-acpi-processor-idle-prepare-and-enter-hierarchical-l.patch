@@ -2208,13 +2464,18 @@ static void acpi_processor_setup_cpuidle_states(struct acpi_processor *pr)
 		memset(&drv->states[i], 0, sizeof(drv->states[i]));
 
 	if (pr->flags.has_lpi) {
