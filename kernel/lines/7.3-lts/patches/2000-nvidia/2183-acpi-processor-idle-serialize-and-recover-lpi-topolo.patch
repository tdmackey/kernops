+	if (dev) {
+		cpuidle_pause_and_lock();
+		cpuidle_unregister_device_no_lock(dev);
+		per_cpu(acpi_cpuidle_device, cpu) = NULL;
+		kfree(dev);
+		cpuidle_resume_and_unlock();
