---
 drivers/vfio/pci/nvgrace-gpu/main.c | 10 ++++++++--
 1 file changed, 8 insertions(+), 2 deletions(-)

diff --git a/drivers/vfio/pci/nvgrace-gpu/main.c b/drivers/vfio/pci/nvgrace-gpu/main.c
index 6144e26039a9..f3fc1ba085dd 100644
--- a/drivers/vfio/pci/nvgrace-gpu/main.c
+++ b/drivers/vfio/pci/nvgrace-gpu/main.c
@@ -1389,7 +1389,10 @@ static int nvgrace_gpu_probe(struct pci_dev *pdev,
 		nvdev->core_device.pci_ops = &nvgrace_gpu_pci_dev_ops;
 
 		if (egm_enabled) {
-			register_egm_node(pdev);
+			ret = register_egm_node(pdev);
+			if (ret)
+				goto out_put_vdev;
+
 			nvdev->egm_node = egmpxm;
 		}
 
@@ -1399,10 +1402,13 @@ static int nvgrace_gpu_probe(struct pci_dev *pdev,
 
 	ret = vfio_pci_core_register_device(&nvdev->core_device);
 	if (ret)
-		goto out_put_vdev;
+		goto out_egm_unreg;
 
 	return ret;
 
+out_egm_unreg:
+	if (egm_enabled)
+		unregister_egm_node(nvdev->egm_node);
 out_put_vdev:
 	vfio_put_device(&nvdev->core_device.vdev);
 	return ret;
