 obj-$(CONFIG_SOUNDWIRE_MTK) += soundwire-mtk.o
diff --git a/drivers/soundwire/mtk-sdw-common.h b/drivers/soundwire/mtk-sdw-common.h
index 30e3645abe04..32912b1272ad 100644
--- a/drivers/soundwire/mtk-sdw-common.h
+++ b/drivers/soundwire/mtk-sdw-common.h
@@ -69,6 +69,7 @@ struct mtk_sdw {
 	struct mtk_sdw_dai *dais;
 	int num_dais;
 	u16 dp_pdi_mask[MTK_SDW_MAX_DP];
