+	list_for_each_entry_safe_reverse(step, tmp, &data->transaction, node) {
+		ret = acpi_lpi_remove_domain(step->entry);
+		if (ret) {
+			acpi_lpi_pd_free_transaction(data);
+			return ret;
+		}
+
+		list_del(&step->node);
+		kfree(step);
+	}
+
+	return 0;
+}
