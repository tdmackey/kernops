-const struct sdw_master_ops mtk_sdw_core_ops = {
-	.read_prop        = mtk_sdw_read_prop,
-	.read_ping_status = mtk_sdw_read_ping_status,
-	.xfer_msg         = mtk_sdw_xfer_msg,
