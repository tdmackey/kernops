+
+enum mt8901_afe_clk_domain {
+	MT8901_HOPPING_CLK_DOMAIN = 0,
+	MT8901_APLL_CLK_DOMAIN = 1,
+};
+
+enum mtk_sdw_sample_rate {
+	RATE_384000 = 384000,
+	RATE_352800 = 352800,
+	RATE_192000 = 192000,
+	RATE_176400 = 176400,
+	RATE_96000 = 96000,
