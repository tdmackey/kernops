Signed-off-by: Jacob Martin <jacob.martin@canonical.com>
Ledger-Change: C-00550
Ledger-Origin: nvidia@c042107ce156569bcfc890877e727c95a37101aa
---
 include/linux/resctrl.h | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/include/linux/resctrl.h b/include/linux/resctrl.h
index ba3d6a8d83c6..e8bf5f9e12c2 100644
--- a/include/linux/resctrl.h
+++ b/include/linux/resctrl.h
@@ -54,7 +54,9 @@ enum resctrl_res_level {
 	RDT_RESOURCE_MBA,
 	RDT_RESOURCE_SMBA,
 	RDT_RESOURCE_PERF_PKG,
-	RDT_RESOURCE_LAST = RDT_RESOURCE_PERF_PKG
+	RDT_RESOURCE_L3_MAX,
+	RDT_RESOURCE_L2_MAX,
+	RDT_RESOURCE_LAST = RDT_RESOURCE_L2_MAX
 };
 
 #define RDT_NUM_RESOURCES (RDT_RESOURCE_LAST + 1)
