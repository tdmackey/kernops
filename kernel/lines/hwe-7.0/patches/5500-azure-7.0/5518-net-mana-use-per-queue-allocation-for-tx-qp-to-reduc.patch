 		txq->ndev = net;
@@ -2447,7 +2458,7 @@ static int mana_create_txq(struct mana_port_context *apc,
 			goto out;
 
 		/* Create SQ's CQ */
-		cq = &apc->tx_qp[i].tx_cq;
+		cq = &apc->tx_qp[i]->tx_cq;
 		cq->type = MANA_CQ_TYPE_TX;
 
 		cq->txq = txq;
@@ -2476,7 +2487,7 @@ static int mana_create_txq(struct mana_port_context *apc,
 
