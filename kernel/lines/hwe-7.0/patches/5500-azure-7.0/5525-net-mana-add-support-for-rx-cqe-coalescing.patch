-		++ndev->stats.rx_dropped;
-		netdev_warn_once(ndev,
-			"Dropped oversized RX packet: len=%u, datasize=%u\n",
-			pktlen, rxq->datasize);
+			/* Reuse the RX buffer since rxbuf_oob is unchanged. */
+		} else {
 
-		/* Reuse the RX buffer since rxbuf_oob is unchanged. */
-	} else {
