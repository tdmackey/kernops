 fail:
-	drm_exec_fini(&submit->exec);
+	drm_exec_fini(exec);
 	return ret;
 }
 
-static void
-v3d_submit_unlock_reservations(struct v3d_submit *submit)
-{
-	drm_exec_fini(&submit->exec);
-}
