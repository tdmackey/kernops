-		for (i = 0; i < submit->job_count; i++) {
-			struct v3d_job *job = submit->jobs[i];
+	int i, ret;
 
-			ret = drm_exec_prepare_array(&submit->exec, job->bo,
-						     job->bo_count, 1);
