From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Jamie Nguyen <jamien@nvidia.com>
Date: Mon, 28 Sep 2026 11:03:47 -0700
Subject: [PATCH] Revert "dma-buf: Rename dma_buf_move_notify() to
 dma_buf_invalidate_mappings()"

BugLink: https://bugs.launchpad.net/bugs/2167041

This reverts commit 1d990d53b1ac5edf3caa5f190b041c9e122659aa.

The two dma-buf API renames break out-of-tree modules that users build
against this kernel. DOCA-OFED releases before 3.3.1, including 3.2.x
and 3.3.0, use .move_notify unconditionally and fail to build:

  drivers/infiniband/hw/mlx5/mr.c:2006:10: error: 'struct dma_buf_attach_ops' has no member named 'move_notify'

The NVIDIA GPU driver's conftest pairs the .move_notify callback with
dma_buf_move_notify(), so both renames must be reverted together. The
vfio/pci and iommufd fixes that were backported alongside the rename
stay.

[jamien: Resolve a conflict in vfio_pci_dma_buf_move() and
 vfio_pci_dma_buf_cleanup() by keeping the code from the later vfio
 fixes, and call dma_buf_move_notify() instead of
 dma_buf_invalidate_mappings().]
Signed-off-by: Jamie Nguyen <jamien@nvidia.com>
Acked-by: Carol L Soto <csoto@nvidia.com>
Acked-by: Matthew R. Ochs <mochs@nvidia.com>
Signed-off-by: Brad Figg <bfigg@nvidia.com>
Ledger-Change: C-02205
Ledger-Origin: nvidia-bos@dbe44b13b6c33e87ad0d2b03882fc2746c106aa1
---
 drivers/dma-buf/dma-buf.c                  | 8 ++++----
 drivers/gpu/drm/amd/amdgpu/amdgpu_object.c | 2 +-
 drivers/gpu/drm/xe/xe_bo.c                 | 2 +-
 drivers/iommu/iommufd/selftest.c           | 2 +-
 drivers/vfio/pci/vfio_pci_dmabuf.c         | 2 +-
 include/linux/dma-buf.h                    | 2 +-
 6 files changed, 9 insertions(+), 9 deletions(-)

diff --git a/drivers/dma-buf/dma-buf.c b/drivers/dma-buf/dma-buf.c
index 0d7dff6b55dc..9a0f696c6036 100644
--- a/drivers/dma-buf/dma-buf.c
+++ b/drivers/dma-buf/dma-buf.c
@@ -1007,7 +1007,7 @@ dma_buf_pin_on_map(struct dma_buf_attachment *attach)
  * 3. Exporters must hold the dma-buf reservation lock when calling these
  *    functions:
  *
- *     - dma_buf_invalidate_mappings()
+ *     - dma_buf_move_notify()
  */
 
 /**
@@ -1349,14 +1349,14 @@ void dma_buf_unmap_attachment_unlocked(struct dma_buf_attachment *attach,
 EXPORT_SYMBOL_NS_GPL(dma_buf_unmap_attachment_unlocked, "DMA_BUF");
 
 /**
- * dma_buf_invalidate_mappings - notify attachments that DMA-buf is moving
+ * dma_buf_move_notify - notify attachments that DMA-buf is moving
  *
  * @dmabuf:	[in]	buffer which is moving
  *
  * Informs all attachments that they need to destroy and recreate all their
  * mappings.
  */
-void dma_buf_invalidate_mappings(struct dma_buf *dmabuf)
+void dma_buf_move_notify(struct dma_buf *dmabuf)
 {
 	struct dma_buf_attachment *attach;
 
@@ -1366,7 +1366,7 @@ void dma_buf_invalidate_mappings(struct dma_buf *dmabuf)
 		if (attach->importer_ops)
 			attach->importer_ops->move_notify(attach);
 }
-EXPORT_SYMBOL_NS_GPL(dma_buf_invalidate_mappings, "DMA_BUF");
+EXPORT_SYMBOL_NS_GPL(dma_buf_move_notify, "DMA_BUF");
 
 /**
  * DOC: cpu access
diff --git a/drivers/gpu/drm/amd/amdgpu/amdgpu_object.c b/drivers/gpu/drm/amd/amdgpu/amdgpu_object.c
index 740b32bd510f..5401efe3e92a 100644
--- a/drivers/gpu/drm/amd/amdgpu/amdgpu_object.c
+++ b/drivers/gpu/drm/amd/amdgpu/amdgpu_object.c
@@ -1277,7 +1277,7 @@ void amdgpu_bo_move_notify(struct ttm_buffer_object *bo,
 
 	if (abo->tbo.base.dma_buf && !drm_gem_is_imported(&abo->tbo.base) &&
 	    old_mem && old_mem->mem_type != TTM_PL_SYSTEM)
-		dma_buf_invalidate_mappings(abo->tbo.base.dma_buf);
+		dma_buf_move_notify(abo->tbo.base.dma_buf);
 
 	/* move_notify is called before move happens */
 	trace_amdgpu_bo_move(abo, new_mem ? new_mem->mem_type : -1,
diff --git a/drivers/gpu/drm/xe/xe_bo.c b/drivers/gpu/drm/xe/xe_bo.c
index 442b3273d323..f3c203a893e7 100644
--- a/drivers/gpu/drm/xe/xe_bo.c
+++ b/drivers/gpu/drm/xe/xe_bo.c
@@ -918,7 +918,7 @@ static int xe_bo_move_notify(struct xe_bo *bo,
 
 	/* Don't call move_notify() for imported dma-bufs. */
 	if (ttm_bo->base.dma_buf && !ttm_bo->base.import_attach)
-		dma_buf_invalidate_mappings(ttm_bo->base.dma_buf);
+		dma_buf_move_notify(ttm_bo->base.dma_buf);
 
 	/*
 	 * TTM has already nuked the mmap for us (see ttm_bo_unmap_virtual),
diff --git a/drivers/iommu/iommufd/selftest.c b/drivers/iommu/iommufd/selftest.c
index 93a05f1ae908..fff11d78a47e 100644
--- a/drivers/iommu/iommufd/selftest.c
+++ b/drivers/iommu/iommufd/selftest.c
@@ -2118,7 +2118,7 @@ static int iommufd_test_dmabuf_revoke(struct iommufd_ucmd *ucmd, int fd,
 	priv = dmabuf->priv;
 	dma_resv_lock(dmabuf->resv, NULL);
 	priv->revoked = revoked;
-	dma_buf_invalidate_mappings(dmabuf);
+	dma_buf_move_notify(dmabuf);
 	dma_resv_unlock(dmabuf->resv);
 
 err_put:
diff --git a/drivers/vfio/pci/vfio_pci_dmabuf.c b/drivers/vfio/pci/vfio_pci_dmabuf.c
index f21bd50b575f..75441b794581 100644
--- a/drivers/vfio/pci/vfio_pci_dmabuf.c
+++ b/drivers/vfio/pci/vfio_pci_dmabuf.c
@@ -357,7 +357,7 @@ void vfio_pci_dma_buf_move(struct vfio_pci_core_device *vdev, bool revoked)
 			dma_resv_lock(priv->dmabuf->resv, NULL);
 			if (revoked)
 				priv->revoked = true;
-			dma_buf_invalidate_mappings(priv->dmabuf);
+			dma_buf_move_notify(priv->dmabuf);
 			dma_resv_wait_timeout(priv->dmabuf->resv,
 					      DMA_RESV_USAGE_BOOKKEEP, false,
 					      MAX_SCHEDULE_TIMEOUT);
diff --git a/include/linux/dma-buf.h b/include/linux/dma-buf.h
index 43044db1931d..facaa9e2f7e9 100644
--- a/include/linux/dma-buf.h
+++ b/include/linux/dma-buf.h
@@ -579,7 +579,7 @@ struct sg_table *dma_buf_map_attachment(struct dma_buf_attachment *,
 					enum dma_data_direction);
 void dma_buf_unmap_attachment(struct dma_buf_attachment *, struct sg_table *,
 				enum dma_data_direction);
-void dma_buf_invalidate_mappings(struct dma_buf *dma_buf);
+void dma_buf_move_notify(struct dma_buf *dma_buf);
 int dma_buf_begin_cpu_access(struct dma_buf *dma_buf,
 			     enum dma_data_direction dir);
 int dma_buf_end_cpu_access(struct dma_buf *dma_buf,
