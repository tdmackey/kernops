From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Jiandi An <jan@nvidia.com>
Date: Sat, 10 Oct 2026 00:31:45 -0500
Subject: [PATCH] NVIDIA: VR: SAUCE: cxl: Do not probe HDM registers on
 unassigned BARs

BugLink: https://bugs.launchpad.net/bugs/2170528

pci_cxl_hdm_init() ran from pci_init_capabilities(), that is from
pci_device_add() during pci_scan_child_bus(), before PCI resource
assignment. A BAR that firmware left unprogrammed reports its size but
keeps a start of 0, and __pci_read_base() does not mark it
IORESOURCE_UNSET in that case, so cxl_decode_regblock() happily computed
a register block at physical address 0 + offset. The cache init then
enabled PCI_COMMAND_MEMORY, ioremapped that address and read it, which
takes a synchronous external abort on arm64 and panics init.

This was hit on NVIDIA Vera Rubin NVL72 when UEFI handed the OS a Rubin
GPU whose BARs had been lost to a reset after firmware programmed them:

  pci 0002:81:00.0: BAR 0 [mem 0x00000000-0x0fffffff 64bit pref]
  Internal error: synchronous external abort: 0000000096000410 [#1] SMP
  pc : cxl_probe_component_regs+0x4c/0x388
  Kernel panic - not syncing: Attempted to kill init!

Move the cache init to pci_bus_add_device(), after resource assignment
and before driver binding, and reject a register block whose BAR is not
assigned before enabling memory decode or mapping anything. Route the
other two BAR consumers through the same predicate and reject a DVSEC
that advertises no HDM decoders.

Take pci_dev_lock() around the command toggle and the MMIO probe. The
sysfs reset and config attributes are already live by the time
pci_bus_add_device() runs, and pci_reset_function() holds pci_dev_lock()
when it reaches cxl_rwsem.dpa through cxl_reset_function(), so this is
the established nesting order.

Based on the rework in Srirangan Madhavan's v12-v14 postings:
https://lore.kernel.org/linux-cxl/20261001092227.3004747-1-smadhavan@nvidia.com/

Fixes: 017d76d5ca2b ("NVIDIA: VR: SAUCE: cxl: Cache endpoint decoder settings during PCI enumeration")
Signed-off-by: Jiandi An <jan@nvidia.com>
Acked-by: Jamie Nguyen <jamien@nvidia.com>
Acked-by: Matthew R. Ochs <mochs@nvidia.com>
Acked-by: Nirmoy Das <nirmoyd@nvidia.com>
Signed-off-by: Brad Figg <bfigg@nvidia.com>
Ledger-Change: C-02225
Ledger-Origin: nvidia-bos@42ca45df0a3ffa089fd63f6b9527daf955d7b222
---
 drivers/cxl/core/reset.c | 74 ++++++++++++++++++++++++++++++----------
 drivers/pci/bus.c        |  2 ++
 drivers/pci/probe.c      |  1 -
 3 files changed, 58 insertions(+), 19 deletions(-)

diff --git a/drivers/cxl/core/reset.c b/drivers/cxl/core/reset.c
index 4df5bace63e8..1caf2afdcd90 100644
--- a/drivers/cxl/core/reset.c
+++ b/drivers/cxl/core/reset.c
@@ -13,6 +13,7 @@
 #include <linux/kernel.h>
 #include <linux/list.h>
 #include <linux/memregion.h>
+#include <linux/overflow.h>
 #include <linux/pci.h>
 #include <linux/slab.h>
 
@@ -216,6 +217,28 @@ void pci_cxl_hdm_release(struct pci_dev *pdev)
 	kfree(info);
 }
 
+/*
+ * A BAR that firmware left unprogrammed still reports its size, but
+ * __pci_read_base() leaves it at start 0 without setting IORESOURCE_UNSET,
+ * so the start test below is what catches that case. IORESOURCE_UNSET
+ * covers a BAR whose assignment was attempted and failed.
+ */
+static bool cxl_pci_bar_usable(struct pci_dev *pdev, int bar)
+{
+	struct resource *res = &pdev->resource[bar];
+
+	if (!pci_resource_len(pdev, bar))
+		return false;
+	if (res->flags & (IORESOURCE_UNSET | IORESOURCE_DISABLED))
+		return false;
+	if (resource_type(res) != IORESOURCE_MEM)
+		return false;
+	if (!res->start || !res->end)
+		return false;
+
+	return true;
+}
+
 static int cxl_pci_hdm_find_bar(struct pci_dev *pdev, resource_size_t hdm_start,
 				resource_size_t hdm_size, int *bar,
 				resource_size_t *offset)
@@ -225,9 +248,7 @@ static int cxl_pci_hdm_find_bar(struct pci_dev *pdev, resource_size_t hdm_start,
 	for (int i = 0; i < PCI_STD_NUM_BARS; i++) {
 		struct resource *res = &pdev->resource[i];
 
-		if (!pci_resource_len(pdev, i))
-			continue;
-		if (resource_type(res) != IORESOURCE_MEM)
+		if (!cxl_pci_bar_usable(pdev, i))
 			continue;
 		if (hdm_start < res->start || hdm_end > res->end)
 			continue;
@@ -277,11 +298,17 @@ static void __iomem *cxl_pci_hdm_ioremap_current(struct pci_dev *pdev,
 	if (bar < 0 || bar >= PCI_STD_NUM_BARS || !size)
 		return ERR_PTR(-EINVAL);
 
+	if (!cxl_pci_bar_usable(pdev, bar))
+		return ERR_PTR(-ENODEV);
+
 	bar_len = pci_resource_len(pdev, bar);
-	if (!bar_len || offset > bar_len || size > bar_len - offset)
+	if (offset > bar_len || size > bar_len - offset)
 		return ERR_PTR(-ENODEV);
 
-	hdm_start = pci_resource_start(pdev, bar) + offset;
+	if (check_add_overflow(pci_resource_start(pdev, bar), offset,
+			       &hdm_start))
+		return ERR_PTR(-EOVERFLOW);
+
 	hdm = ioremap(hdm_start, size);
 	if (!hdm) {
 		pci_err(pdev, "failed to remap CXL HDM decoder registers\n");
@@ -380,7 +407,8 @@ static int cxl_pci_hdm_capable(struct pci_dev *pdev)
 	if (rc)
 		return pcibios_err_to_errno(rc);
 
-	if (!(cap & PCI_DVSEC_CXL_MEM_CAPABLE))
+	if (!(cap & PCI_DVSEC_CXL_MEM_CAPABLE) ||
+	    !FIELD_GET(PCI_DVSEC_CXL_HDM_COUNT, cap))
 		return -ENOTTY;
 
 	return 0;
@@ -396,7 +424,7 @@ static int __pci_cxl_hdm_init(struct pci_dev *pdev)
 	bool allocated_info = false;
 	int decoder_count;
 	int dvsec;
-	u16 command;
+	u16 command = 0;
 	int rc;
 
 	scoped_guard(rwsem_read, &cxl_rwsem.dpa) {
@@ -409,19 +437,29 @@ static int __pci_cxl_hdm_init(struct pci_dev *pdev)
 	if (rc)
 		return rc;
 
-	rc = pci_read_config_word(pdev, PCI_COMMAND, &command);
+	/*
+	 * Locate the register block and confirm its BAR is assigned before
+	 * enabling memory decode or mapping anything. Firmware can hand over
+	 * a device whose BARs it never programmed, and probing MMIO off such
+	 * a BAR takes an external abort on some architectures.
+	 */
+	rc = cxl_find_regblock(pdev, CXL_REGLOC_RBI_COMPONENT, &map);
 	if (rc)
-		return pcibios_err_to_errno(rc);
+		return rc;
 
-	if (!(command & PCI_COMMAND_MEMORY))
-		restore_command = true;
+	if (map.bar_index >= PCI_STD_NUM_BARS ||
+	    !cxl_pci_bar_usable(pdev, map.bar_index))
+		return -ENODEV;
 
-	if (restore_command) {
-		rc = pci_write_config_word(pdev, PCI_COMMAND,
-					   command | PCI_COMMAND_MEMORY);
-		if (rc)
-			return pcibios_err_to_errno(rc);
-	}
+	/*
+	 * pci_bus_add_device() has already published the sysfs and procfs
+	 * attributes, so the reset and config files are live while the
+	 * PCI_COMMAND toggle and the MMIO probe below run. Serialise against
+	 * them. pci_reset_function() already holds pci_dev_lock() when it
+	 * reaches cxl_rwsem.dpa through cxl_reset_function(), so taking the
+	 * device lock here keeps that established nesting order.
+	 */
+	guard(pci_dev)(pdev);
 
 	if (!info) {
 		info = kzalloc_obj(*info, GFP_KERNEL);
@@ -445,7 +483,7 @@ static int __pci_cxl_hdm_init(struct pci_dev *pdev)
 	}
 	info->dvsec_ctrl_valid = true;
 
-	rc = cxl_find_regblock(pdev, CXL_REGLOC_RBI_COMPONENT, &map);
+	rc = cxl_hdm_enable_mem(pdev, &command, &restore_command);
 	if (rc)
 		goto out_restore_command;
 
diff --git a/drivers/pci/bus.c b/drivers/pci/bus.c
index 6c1ad1f542d9..eb1fcf36ba29 100644
--- a/drivers/pci/bus.c
+++ b/drivers/pci/bus.c
@@ -18,6 +18,7 @@
 #include <linux/pm_runtime.h>
 #include <linux/proc_fs.h>
 #include <linux/slab.h>
+#include <cxl/cxl.h>
 
 #include "pci.h"
 
@@ -360,6 +361,7 @@ void pci_bus_add_device(struct pci_dev *dev)
 
 	/* Save config space for error recoverability */
 	pci_save_state(dev);
+	pci_cxl_hdm_init(dev);		/* CXL HDM Decoder Capability */
 
 	/*
 	 * Enable runtime PM, which potentially allows the device to
diff --git a/drivers/pci/probe.c b/drivers/pci/probe.c
index 490ce09da302..b9aa423e1aac 100644
--- a/drivers/pci/probe.c
+++ b/drivers/pci/probe.c
@@ -2676,7 +2676,6 @@ static void pci_init_capabilities(struct pci_dev *dev)
 	pci_rebar_init(dev);		/* Resizable BAR */
 	pci_dev3_init(dev);		/* Device 3 capabilities */
 	pci_ide_init(dev);		/* Link Integrity and Data Encryption */
-	pci_cxl_hdm_init(dev);		/* CXL HDM Decoder Capability */
 
 	pcie_report_downtraining(dev);
 	pci_init_reset_methods(dev);
