diff --git a/include/cxl/cxl.h b/include/cxl/cxl.h
index b2ef9e3d15bb..a051f4285f90 100644
--- a/include/cxl/cxl.h
+++ b/include/cxl/cxl.h
@@ -36,6 +36,7 @@ enum cxl_devtype {
