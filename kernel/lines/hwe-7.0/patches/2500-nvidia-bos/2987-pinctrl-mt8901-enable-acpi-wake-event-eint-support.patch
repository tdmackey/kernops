index df8dce14744f..bf71a12b8a70 100644
--- a/drivers/pinctrl/mediatek/pinctrl-mtk-common-v2.h
+++ b/drivers/pinctrl/mediatek/pinctrl-mtk-common-v2.h
@@ -283,7 +283,9 @@ struct mtk_pin_soc {
 			     const struct mtk_pin_desc *desc, u32 arg);
 	int (*adv_drive_get)(struct mtk_pinctrl *hw,
 			     const struct mtk_pin_desc *desc, u32 *val);
-
+	/* EINTs whose event mask must be cleared so they can wake the SPM */
+	const unsigned int *eint_event_unmask;
+	const unsigned int num_eint_event_unmask;
 	/* Specific driver data */
 	void				*driver_data;
 };
diff --git a/drivers/pinctrl/mediatek/pinctrl-paris.c b/drivers/pinctrl/mediatek/pinctrl-paris.c
index 517801d4f9e9..7da602170449 100644
--- a/drivers/pinctrl/mediatek/pinctrl-paris.c
+++ b/drivers/pinctrl/mediatek/pinctrl-paris.c
@@ -975,6 +975,13 @@ static int mtk_build_gpiochip(struct mtk_pinctrl *hw)
 	return 0;
 }
 
+static void mtk_pinctrl_acpi_free_interrupts(void *data)
+{
+	struct gpio_chip *chip = data;
+
+	acpi_gpiochip_free_interrupts(chip);
+}
+
 static int mtk_pctrl_build_state(struct platform_device *pdev)
 {
 	struct mtk_pinctrl *hw = platform_get_drvdata(pdev);
@@ -1096,6 +1103,19 @@ int mtk_paris_pinctrl_probe(struct platform_device *pdev)
 		return dev_err_probe(dev, err, "Failed to add gpio_chip\n");
 
 	pinctrl_add_gpio_range(hw->pctrl, &hw->range);
+	if (hw->eint) {
+		acpi_gpiochip_request_interrupts(&hw->chip);
+
+		err = devm_add_action_or_reset(dev,
+					       mtk_pinctrl_acpi_free_interrupts,
+					       &hw->chip);
+		if (err) {
+			pinctrl_remove_gpio_range(hw->pctrl, &hw->range);
+			gpiochip_remove(&hw->chip);
+			return dev_err_probe(dev, err,
+					     "Failed to add ACPI GPIO cleanup\n");
+		}
+	}
 
 	platform_set_drvdata(pdev, hw);
 
