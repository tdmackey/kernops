+static const guid_t nvidia_notify_dsm_guid =
+	GUID_INIT(0x7681541e, 0x8827, 0x4239, 0x8d, 0x9d, 0x36, 0xbe, 0x7f, 0xe1, 0x25, 0x42);
+
+#define NVIDIA_FFA_MAX_NOTIFICATIONS	64
