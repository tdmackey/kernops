 arch/arm64/include/asm/mpam.h        | 62 ++++++++++++++++++++++++++++
 arch/arm64/include/asm/thread_info.h |  3 ++
 arch/arm64/kernel/Makefile           |  1 +
 arch/arm64/kernel/mpam.c             | 11 +++++
 arch/arm64/kernel/process.c          |  7 ++++
