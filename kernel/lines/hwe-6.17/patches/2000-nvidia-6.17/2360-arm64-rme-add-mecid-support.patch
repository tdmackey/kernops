+			/* At the moment this is a bool: 0=private MECID */
+			__u32	shared_mec;
+		};
+
+		/* cfg == ARM_RME_CONFIG_MEC_QUERY - output */
+		struct {
+			__u32	mec_supported;	/* 0=not supported, 1=supported */
+			__u32	mec_count;	/* Number of available MECIDs */
+		};
 		/* Fix the size of the union */
