+	   enum mpam_device_features mon_type,
 	   int mon_idx,
 	   enum resctrl_conf_type cdp_type, u32 closid, u32 rmid, u64 *val)
 {
@@ -484,7 +501,6 @@ __read_mon(struct mpam_resctrl_mon *mon, struct mpam_component *mon_comp,
 	cfg.match_pmg = true;
 	cfg.partid = closid;
