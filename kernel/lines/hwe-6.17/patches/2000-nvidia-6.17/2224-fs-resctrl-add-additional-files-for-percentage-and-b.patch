 		.mode		= 0444,
@@ -1998,6 +2005,13 @@ static struct rftype res_common_files[] = {
 		.seq_show	= rdt_min_cbm_bits_show,
 		.fflags		= RFTYPE_CTRL_INFO | RFTYPE_RES_CACHE,
