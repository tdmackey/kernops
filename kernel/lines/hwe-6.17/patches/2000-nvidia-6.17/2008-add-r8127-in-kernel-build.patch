-        int i;
-
-        for (i = 0; i < R8127_CHANNEL_WAIT_COUNT; i++)
-                if (!(rtl8127_mdio_direct_read_phy_ocp(tp, PTP_TRX_TS_STA) & TRX_TS_RD))
-                        break;
-}
