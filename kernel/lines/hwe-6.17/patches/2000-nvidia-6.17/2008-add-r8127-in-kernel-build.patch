-        RSS_CTRL_IPV6_EXT_SUPP  = (1 << 4),
-        RSS_CTRL_TCP_IPV6_EXT_SUPP  = (1 << 5),
-        RSS_HALF_SUPP  = (1 << 7),
-        RSS_CTRL_UDP_IPV4_SUPP  = (1 << 11),
-        RSS_CTRL_UDP_IPV6_SUPP  = (1 << 12),
-        RSS_CTRL_UDP_IPV6_EXT_SUPP  = (1 << 13),
-        RSS_QUAD_CPU_EN  = (1 << 16),
-        RSS_HQ_Q_SUP_R  = (1 << 31),
-};
