From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Koba Ko <kobak@nvidia.com>
Date: Wed, 1 Apr 2026 01:44:46 +0800
Subject: [PATCH] NVIDIA: VR: SAUCE: firmware: tegra: bpmp-tegra410: reject
 duplicate mbwt export

BugLink: https://bugs.launchpad.net/bugs/2147212

export_store() blindly calls device_register() without checking if the
requested instance is already exported, causing repeated kobject
"don't try to register things with the same name" errors when userspace
writes the same instance number more than once.

Add a device_find_child() guard before allocation to return -EBUSY
early, reusing the existing bpmp_unexport_match() callback. Also clean
up dead code: drop the pointless 'export = NULL' on the error path and
replace 'ret ? : len' with a direct 'return len' since ret is always 0
at that point.

Fixes: bb89f8b44e66 ("tegra: bpmp: Add BPMP client driver for T410")
Signed-off-by: Koba Ko <kobak@nvidia.com>
Acked-by: Carol L Soto <csoto@nvidia.com>
Acked-by: Fenghua Yu <fenghuay@nvidia.com>
Acked-by: Matthew R. Ochs <mochs@nvidia.com>
Acked-by: Abdur Rahman <abdur.rahman@canonical.com>
Acked-by: Jacob Martin <jacob.martin@canonical.com>
Signed-off-by: Brad Figg <bfigg@nvidia.com>
Ledger-Change: C-00572
Ledger-Origin: nvidia-6.17@077c6e1d6b1ac10150f49e0685c3ab409cb397e7
---
 drivers/firmware/tegra/bpmp-tegra410.c | 25 +++++++++++++++----------
 1 file changed, 15 insertions(+), 10 deletions(-)

diff --git a/drivers/firmware/tegra/bpmp-tegra410.c b/drivers/firmware/tegra/bpmp-tegra410.c
index f702cea7213c..97c47044af52 100644
--- a/drivers/firmware/tegra/bpmp-tegra410.c
+++ b/drivers/firmware/tegra/bpmp-tegra410.c
@@ -195,6 +195,13 @@ static struct attribute *bpmp_membw_attrs[] = {
 ATTRIBUTE_GROUPS(bpmp_membw);
 
 
+static int bpmp_unexport_match(struct device *child, const void *data)
+{
+	struct bpmp_export *export = child_to_bpmp_export(child);
+
+	return export->instance == *(unsigned int *)data;
+}
+
 static ssize_t export_store(struct device *parent,
 			    struct device_attribute *attr,
 			    const char *buf, size_t len)
@@ -202,12 +209,19 @@ static ssize_t export_store(struct device *parent,
 	int ret;
 	struct tegra_bpmp *bpmp = dev_get_drvdata(parent);
 	struct bpmp_export *export;
+	struct device *existing;
 	u32 instance;
 
 	ret = kstrtouint(buf, 0, &instance);
 	if (ret < 0)
 		return ret;
 
+	existing = device_find_child(parent, &instance, bpmp_unexport_match);
+	if (existing) {
+		put_device(existing);
+		return -EBUSY;
+	}
+
 	export = kzalloc(sizeof(*export), GFP_KERNEL);
 	if (!export)
 		return -ENOMEM;
@@ -224,22 +238,13 @@ static ssize_t export_store(struct device *parent,
 	ret = device_register(&export->child);
 	if (ret) {
 		put_device(&export->child);
-		export = NULL;
 		return ret;
 	}
 
-	return ret ? : len;
+	return len;
 }
 static DEVICE_ATTR_WO(export);
 
-
-static int bpmp_unexport_match(struct device *child, const void *data)
-{
-	struct bpmp_export *export = child_to_bpmp_export(child);
-
-	return export->instance == *(unsigned int *)data;
-}
-
 static ssize_t unexport_store(struct device *parent,
 			    struct device_attribute *attr,
 			    const char *buf, size_t len)
