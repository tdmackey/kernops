---
 drivers/vfio/pci/nvgrace-gpu/egm.c | 3 +--
 1 file changed, 1 insertion(+), 2 deletions(-)

diff --git a/drivers/vfio/pci/nvgrace-gpu/egm.c b/drivers/vfio/pci/nvgrace-gpu/egm.c
index 1f8f0f7b2249..463d1dd3e9c0 100644
--- a/drivers/vfio/pci/nvgrace-gpu/egm.c
+++ b/drivers/vfio/pci/nvgrace-gpu/egm.c
@@ -325,8 +325,6 @@ static void nvgrace_egm_fetch_bad_pages(struct pci_dev *pdev,
 
 	count = *(u64 *)memaddr;
 
-	hash_init(region->htbl);
-
 	for (index = 0; index < count; index++) {
 		struct h_node *retired_page;
 
@@ -366,6 +364,7 @@ int register_egm_node(struct pci_dev *pdev)
 	region->egmlength = egmlength;
 	region->egmpxm = egmpxm;
 
+	hash_init(region->htbl);
 	atomic_set(&region->open_count, 0);
 
 	nvgrace_egm_fetch_bad_pages(pdev, region);
