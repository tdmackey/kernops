From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Paolo Pisati <paolo.pisati@canonical.com>
Date: Tue, 29 Nov 2022 16:29:54 +0000
Subject: [PATCH] UBUNTU: SAUCE: fixup
 lock_system_sleep()/unlock_system_sleep()

Signed-off-by: Paolo Pisati <paolo.pisati@canonical.com>
Ledger-Change: C-01463
Ledger-Origin: aws-6.17@7d0506dd0a32d2235ad8e11ae7f1b587b18a7dde
---
 drivers/xen/manage.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/drivers/xen/manage.c b/drivers/xen/manage.c
index fbdb04bec478..c82f55656bfe 100644
--- a/drivers/xen/manage.c
+++ b/drivers/xen/manage.c
@@ -118,9 +118,10 @@ static int xen_suspend(void *data)
 static void do_suspend(void)
 {
 	int err;
+	unsigned int sleep_flags;
 	struct suspend_info si;
 
-	lock_system_sleep();
+	sleep_flags = lock_system_sleep();
 
 	suspend_mode = XEN_SUSPEND;
 
@@ -199,7 +200,7 @@ static void do_suspend(void)
 
 	suspend_mode = NO_SUSPEND;
 
-	unlock_system_sleep();
+	unlock_system_sleep(sleep_flags);
 }
 #endif	/* CONFIG_HIBERNATE_CALLBACKS */
 
