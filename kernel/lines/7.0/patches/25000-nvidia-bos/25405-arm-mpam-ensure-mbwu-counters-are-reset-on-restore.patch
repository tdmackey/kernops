From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Ben Horgan <ben.horgan@arm.com>
Date: Fri, 10 Jul 2026 12:55:39 +0100
Subject: [PATCH] NVIDIA: SAUCE: arm_mpam: Ensure MBWU counters are reset on
 restore

BugLink: https://bugs.launchpad.net/bugs/2167008

When an MSC becomes inaccessible due to cpu offline CFG_MBWU_CTL is set to
zero in mpam_save_mbwu_state(). This is very likely to mean that the config
will mismatch when restoring and so the monitor will be reset. However, the
state may have been lost and so there are no guarantees. Ensure the reset
happens by setting the reset_on_next_read and remove the unnecessary writes
from mpam_save_mbwu_state().

Fixes: 41e8a14950e1 ("arm_mpam: Track bandwidth counter state for power management")
Signed-off-by: Ben Horgan <ben.horgan@arm.com>
(cherry picked from https://lore.kernel.org/r/20260710115546.29644-6-ben.horgan@arm.com)
Signed-off-by: Lee Trager <ltrager@nvidia.com>
Acked-by: Carol L Soto <csoto@nvidia.com>
Acked-by: Jamie Nguyen <jamien@nvidia.com>
Acked-by: Fenghua Yu <fenghuay@nvidia.com>
Signed-off-by: Brad Figg <bfigg@nvidia.com>
Ledger-Change: C-02041
Ledger-Origin: nvidia-bos@b2d8b54a79b4dff88aa511b29cb5822783524d34
---
 drivers/resctrl/mpam_devices.c | 31 +++++++++++++++++--------------
 1 file changed, 17 insertions(+), 14 deletions(-)

diff --git a/drivers/resctrl/mpam_devices.c b/drivers/resctrl/mpam_devices.c
index 47d2c8549835..c6dc5c6e4767 100644
--- a/drivers/resctrl/mpam_devices.c
+++ b/drivers/resctrl/mpam_devices.c
@@ -2034,14 +2034,27 @@ static int mpam_restore_mbwu_state(void *_ris)
 	u64 val;
 	struct mon_read mwbu_arg;
 	struct mpam_msc_ris *ris = _ris;
+	struct msmon_mbwu_state *mbwu_state;
+	struct mpam_msc *msc = ris->vmsc->msc;
 	struct mpam_class *class = ris->vmsc->comp->class;
 
 	for (i = 0; i < ris->props.num_mbwu_mon; i++) {
+		mbwu_state = &ris->mbwu_state[i];
+
 		if (ris->mbwu_state[i].enabled) {
-			mwbu_arg.ris = ris;
-			mwbu_arg.ctx = &ris->mbwu_state[i].cfg;
-			mwbu_arg.type = mpam_msmon_choose_counter(class);
-			mwbu_arg.val = &val;
+			{
+				ACQUIRE(mon_sel_lock, guard)(msc);
+
+				if (ACQUIRE_ERR(mon_sel_lock, &guard))
+					return -EIO;
+
+				mwbu_arg.ris = ris;
+				mwbu_arg.ctx = &ris->mbwu_state[i].cfg;
+				mwbu_arg.type = mpam_msmon_choose_counter(class);
+				mwbu_arg.val = &val;
+
+				mbwu_state->reset_on_next_read = true;
+			}
 
 			__ris_msmon_read(&mwbu_arg);
 			if (mwbu_arg.err && mwbu_arg.err != -EBUSY)
@@ -2081,9 +2094,6 @@ static int mpam_save_mbwu_state(void *arg)
 		if (ret)
 			return ret;
 		ret = mpam_read_monsel_reg(msc, CFG_MBWU_CTL, &cur_ctl);
-		if (ret)
-			return ret;
-		ret = mpam_write_monsel_reg(msc, CFG_MBWU_CTL, 0);
 		if (ret)
 			return ret;
 
@@ -2091,9 +2101,6 @@ static int mpam_save_mbwu_state(void *arg)
 			ret = mpam_msc_read_mbwu_l(msc, &val);
 			if (ret)
 				return ret;
-			ret = mpam_msc_zero_mbwu_l(msc);
-			if (ret)
-				return ret;
 		} else {
 			u32 val32;
 
@@ -2101,10 +2108,6 @@ static int mpam_save_mbwu_state(void *arg)
 			if (ret)
 				return ret;
 			val = val32;
-
-			ret = mpam_write_monsel_reg(msc, MBWU, 0);
-			if (ret)
-				return ret;
 		}
 
 		cfg->mon = i;
