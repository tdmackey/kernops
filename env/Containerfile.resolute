# Builder image for Ubuntu resolute (26.04) kernels — linux 7.0 (6.17 ABI),
# linux-nvidia 7.0. Same shape as Containerfile.noble; resolute-first is the
# original prototyping order.
FROM docker.io/library/ubuntu:26.04

RUN sed -i 's/^Types: deb$/Types: deb deb-src/' /etc/apt/sources.list.d/ubuntu.sources \
 && apt-get update \
 && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      build-essential fakeroot devscripts debhelper equivs ccache git \
      flex bison bc kmod cpio rsync zstd lz4 dwarves file \
      libssl-dev libelf-dev libncurses-dev libudev-dev libpci-dev \
      libiberty-dev libcap-dev python3 gawk curl ca-certificates \
 && DEBIAN_FRONTEND=noninteractive apt-get build-dep -y linux \
 && rm -rf /var/lib/apt/lists/*

ENV PATH=/usr/lib/ccache:$PATH \
    CCACHE_DIR=/ccache \
    CCACHE_MAXSIZE=20G \
    DEBIAN_FRONTEND=noninteractive

RUN git config --global --add safe.directory '*'

# The config step settles every architecture's config, so it needs the other
# architecture's compiler too (Kconfig probes the compiler; nothing is built with it).
RUN case "$(dpkg --print-architecture)" in \
      amd64) cross=gcc-aarch64-linux-gnu ;; \
      arm64) cross=gcc-x86-64-linux-gnu ;; \
    esac \
 && apt-get update \
 && apt-get install -y --no-install-recommends "$cross" \
 && rm -rf /var/lib/apt/lists/*

# What our packaging needs and `apt-get build-dep linux` of this series does
# not bring: the complete LLVM that each line's packaging names (22 for 7.3,
# 21 for 7.0: perf's LLVM support and the BPF skeletons need clang, llvm-config
# and llvm-strip of that release, not clang alone), and the
# debuginfod client, libpfm4, capstone and SDT for perf. scripts/build-line.sh
# lists what is still missing.
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      clang-22 llvm-22-dev llvm-22-tools libllvm22 libdebuginfod-dev \
      clang-21 llvm-21-dev llvm-21-tools libllvm21 \
      libpfm4-dev libcapstone-dev systemtap-sdt-dev \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /src
