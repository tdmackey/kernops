# Builder image for Ubuntu noble (24.04) kernels — hwe-6.17, 7.0,
# linux-nvidia. Native arm64 when built on Apple Silicon / Graviton.
FROM docker.io/library/ubuntu:24.04

# Enable deb-src so `apt-get build-dep linux` tracks the archive's real
# build-deps instead of a hand-maintained package list.
RUN sed -i 's/^Types: deb$/Types: deb deb-src/' /etc/apt/sources.list.d/ubuntu.sources \
 && apt-get update \
 && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      build-essential fakeroot devscripts debhelper equivs ccache git \
      flex bison bc kmod cpio rsync zstd lz4 dwarves file \
      libssl-dev libelf-dev libncurses-dev libudev-dev libpci-dev \
      libiberty-dev libcap-dev python3 gawk curl ca-certificates \
 && DEBIAN_FRONTEND=noninteractive apt-get build-dep -y linux \
 && rm -rf /var/lib/apt/lists/*

# ccache masquerade dir first in PATH; cache lives in a podman named volume
# (VM-local disk) so it survives container runs and avoids virtiofs overhead.
ENV PATH=/usr/lib/ccache:$PATH \
    CCACHE_DIR=/ccache \
    CCACHE_MAXSIZE=20G \
    DEBIAN_FRONTEND=noninteractive

# Source trees are bind-mounted and owned by the host user.
RUN git config --global --add safe.directory '*'

# The config step settles every architecture's config, so it needs the other
# architecture's compiler too (Kconfig probes the compiler; nothing is built with it).
RUN case "$(dpkg --print-architecture)" in \
      amd64) cross=gcc-aarch64-linux-gnu ;; \
      arm64) cross=gcc-x86-64-linux-gnu ;; \
    esac \
 && apt-get update \
 && apt-get install -y --no-install-recommends "$cross" \
 && rm -rf /var/lib/apt/lists/*

# What the 7.3 packaging needs and `apt-get build-dep linux` of this series does
# not bring: the LLVM that kernel/identity.toml names for the series (perf's
# LLVM support and its BPF skeletons need clang and llvm-config), and the
# debuginfod client, libpfm4, capstone and SDT for perf. scripts/build-line.sh
# lists what is still missing.
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      clang-20 llvm-20-dev llvm-20-tools libllvm20 libdebuginfod-dev \
      libpfm4-dev libcapstone-dev systemtap-sdt-dev \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /src
