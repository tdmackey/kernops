# Line endings are part of the content here. Without this, a Windows checkout
# (core.autocrlf=true) rewrites shell scripts and patch files with CRLF.
* text=auto eol=lf

# Patches must round-trip byte for byte: never normalise or convert them.
*.patch -text

*.sh    text eol=lf
*.py    text eol=lf
*.jsonl text eol=lf
*.toml  text eol=lf
*.tsv   text eol=lf
scripts/kpm text eol=lf
